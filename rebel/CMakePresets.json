{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 19,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "default",
      "hidden": true,
      "generator": "Unix Makefiles",
      "binaryDir": "build/${presetName}"
    },
    {
      "name": "habilis-starter",
      "inherits": ["default"],
      "hidden": false,
      "description": "Build for Habilis using Starter app",
      "cacheVariables": {
        "CAR": "habilis",
        "APP": "starter"
      }
    },
    {
      "name": "cheaper-starter",
      "inherits": ["default"],
      "hidden": false,
      "description": "Build for Cheaper using Starter app",
      "cacheVariables": {
        "CAR": "cheaper",
        "APP": "starter"
      }
    }
  ]
}
